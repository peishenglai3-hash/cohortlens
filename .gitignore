# Node
node_modules/
*.log
npm-debug.log*
.pnpm-debug.log*

# Build output
dist/
dist-ssr/
dist-delivery/

# 审阅台的构建产物，由 npm run build:admin 生成
worker/assets/

# 本地校验截图（人工验看用，不属于交付物）
/console-list-and-detail.png
*.local

# 甲方交付包：由 npm run pack:delivery 生成的可分发包。
# 它是构建产物（内含 dist/ 与 dist-delivery/ 的副本），不进版本库；
# 需要交付时重新生成并跑 npm run verify:delivery 核对即可。
delivery/

# 部署脚本的中间输出（含账号信息，不进版本库）
deploy-output.txt

# Test / coverage
coverage/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Environment & secrets — Engineering Bible §30 / Release Gate #20
# No API key may ever be committed. `.env.example` is the only env file allowed in git.
.env
.env.*
!.env.example

# Wrangler local secrets (contains a local-only admin token, never a real one)
.dev.vars
.wrangler/

# Local assessment exports (may contain a respondent's raw answers)
exports/
*.cohortlens.json

# Playwright
playwright-report/
test-results/
blob-report/
