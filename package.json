{
  "name": "cohortlens",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "description": "CohortLens - local-first structured assessment tool for small voluntary teams",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate:questions": "tsx scripts/validate-question-pack.ts",
    "validate:config": "tsx scripts/validate-config.ts",
    "demo:assessment": "tsx scripts/demo-assessment.ts",
    "gate:local": "npm run lint && npm run format:check && npm run typecheck && npm run validate:questions && npm run validate:config && npm run test:coverage && npm run e2e:desktop",
    "e2e": "npm run build && playwright test",
    "e2e:desktop": "npm run build && playwright test --project=chromium-desktop",
    "gate:local:fast": "npm run lint && npm run format:check && npm run typecheck && npm run validate:questions && npm run test:coverage",
    "build:delivery": "vite build --config vite.config.delivery.ts",
    "pack:delivery": "tsx scripts/pack-delivery.ts",
    "verify:delivery": "tsx scripts/verify-delivery.ts",
    "build:admin": "vite build --config vite.config.admin.ts",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "deploy:worker": "npm run build:admin && wrangler deploy",
    "db:create": "wrangler d1 create cohortlens-reviews",
    "db:migrate": "wrangler d1 execute cohortlens-reviews --remote --file=worker/schema.sql",
    "db:invite": "tsx scripts/create-invite.ts",
    "deploy:step1": "tsx scripts/deploy-step1-cloudflare.ts"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.1.1",
    "zod": "3.24.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@eslint/js": "9.17.0",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.0.5",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "fake-indexeddb": "^6.0.0",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.0",
    "vite": "6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "3.0.5"
  }
}
